# Shared config for backup_db.sh and backup_images.sh
# Copy to .env and edit on the server (never commit .env):
#   cp .env.example .env
#
# Priority: already-exported env > this file > script defaults

# One or more backends (comma-separated): gcs | local | s3
# Examples: gcs  |  local  |  local,gcs  |  local,gcs,s3
STORAGE_TYPE="local,gcs"

# --- Database (backup_db.sh) ---
DATABASE_URL=postgres://root:pass@localhost:5432/smartcity_prod

# --- Images (backup_images.sh) ---
IMAGES_DIR=/var/www/smartcity/smartcity-files

# --- Google Cloud Storage ---
GCS_BUCKET=your-backup-bucket
# Path to service account JSON for cron (optional if gcloud is already authenticated)
GCS_CREDENTIALS=
# Per-script object prefixes (used when GCS_PREFIX is not set)
GCS_PREFIX_DB=db
GCS_PREFIX_IMAGES=images

# --- Local disk (STORAGE_TYPE includes local) ---
LOCAL_DIR=/mnt/backups
LOCAL_PREFIX_DB=db
LOCAL_PREFIX_IMAGES=images

# --- Amazon S3 (reserved; implement lib/s3.sh first) ---
# S3_BUCKET=
# S3_REGION=eu-central-1
# S3_PREFIX_DB=db
# S3_PREFIX_IMAGES=images
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# --- Retention / staging ---
# Delete storage + staging backups older than this many days
RETENTION_DAYS=14
# 1 = keep zip in backupit/ until retention; 0 = delete staging after successful upload
KEEP_LOCAL=1
